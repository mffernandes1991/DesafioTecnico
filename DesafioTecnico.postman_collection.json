                  "    pm.response.to.have.jsonBody('city','Brasília')\r",
                  "    pm.response.to.have.jsonBody('district','Samambaia Norte (Samambaia)')\r",
                  "    pm.response.to.have.jsonBody('address','QR 425 Conjunto 2')\r",
                  "});"
